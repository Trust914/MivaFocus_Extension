
{
  "manifest_version": 3,
  "name": "MivaFocus",
  "version": "1.0.0",
  "description": "Filter Miva Open University LMS courses by department, level, and semester",
  "author": "Trust C. Ezekiel-Okezie",
  
  "icons": {

    "128": "icons/icon128.png"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    },
    "default_title": "MivaFocus - Filter Your Courses"
  },
  
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  
 "host_permissions": [
    "https://lms.miva.university/*",
    "https://raw.githubusercontent.com/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
    "content_scripts": [
    {
      "matches": [
        "*://lms.miva.university/*"
        ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["miva_courses_full.json"],
      "matches": ["https://lms.miva.university/*"]
    }
  ]
}